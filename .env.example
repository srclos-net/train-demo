# Copy to .env and fill in your values

# Faro collector URL (from your Grafana Cloud Frontend Observability app)
FARO_COLLECTOR_URL=<faro-collector-url>

# API key for sourcemap uploads (from grafana.com Access Policies)
# Only needed if you run sourcemap uploads as part of the build
FARO_API_KEY=<faro-api-key>
